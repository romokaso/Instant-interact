local isMinimized = false
MinimizeButton.MouseButton1Click:Connect(function()
    if isClosing then return end
    isMinimized = not isMinimized
    
    if isMinimized then
        createTween(MainFrame, {Size = UDim2.new(0, 240, 0, 48)}):Play()
        ContentFrame.Visible = false
        SettingsFrame.Visible = false
        ConfirmFrame.Visible = false
    else
        createTween(MainFrame, {Size = UDim2.new(0, 240, 0, 138)}):Play()
        task.wait(0.2)
        ContentFrame.Visible = true
    end
end)

local settingsOpen = false
SettingsButton.MouseButton1Click:Connect(function()
    if isClosing then return end
    if isMinimized then
        isMinimized = false
        createTween(MainFrame, {Size = UDim2.new(0, 240, 0, 138)}):Play()
        task.wait(0.3)
    end
    
    settingsOpen = not settingsOpen
    ContentFrame.Visible = not settingsOpen
    SettingsFrame.Visible = settingsOpen
    
    if settingsOpen then
        SettingsButton.Active = false
        MinimizeButton.Active = false
        CloseButton.Active = false
    else
        SettingsButton.Active = true
        MinimizeButton.Active = true
        CloseButton.Active = true
    end
end)

BackButton.MouseButton1Click:Connect(function()
    settingsOpen = false
    SettingsFrame.Visible = false
    ContentFrame.Visible = true
    
    SettingsButton.Active = true
    MinimizeButton.Active = true
    CloseButton.Active = true
end)

CloseButton.MouseButton1Click:Connect(function()
    if isClosing then return end
    if isMinimized then
        isMinimized = false
        createTween(MainFrame, {Size = UDim2.new(0, 240, 0, 138)}):Play()
        task.wait(0.3)
    end
    
    if settingsOpen then
        settingsOpen = false
        SettingsFrame.Visible = false
        ContentFrame.Visible = true
        SettingsButton.Active = true
        MinimizeButton.Active = true
        CloseButton.Active = true
        task.wait(0.1)
    end
    
    isClosing = true
    ContentFrame.Visible = false
    ConfirmFrame.Visible = true
end)

