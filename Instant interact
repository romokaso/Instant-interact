local function createTween(object, properties, duration)
    local tweenInfo = TweenInfo.new(
        duration or 0.3,
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )
    return TweenService:Create(object, tweenInfo, properties)
end

local function applyTheme(theme)
    local colors = themes[theme]
    
    createTween(MainFrame, {BackgroundColor3 = colors.main}):Play()
    createTween(TitleBar, {BackgroundColor3 = colors.secondary}):Play()
    createTween(TitleBarBottom, {BackgroundColor3 = colors.secondary}):Play()
    createTween(TitleLabel, {TextColor3 = colors.text}):Play()
    createTween(SettingsTitle, {TextColor3 = colors.text}):Play()
    createTween(CreditLabel, {TextColor3 = colors.textSecondary}):Play()
    createTween(ConfirmFrame, {BackgroundColor3 = colors.main}):Play()
    createTween(ConfirmTitle, {TextColor3 = colors.text}):Play()
    createTween(SettingsFrame, {BackgroundColor3 = colors.main}):Play()
    createTween(SettingsTitleBar, {BackgroundColor3 = colors.secondary}):Play()
    createTween(SettingsTitleBottom, {BackgroundColor3 = colors.secondary}):Play()
end

local function setupProximityPrompt(prompt)
    if not originalPromptSettings[prompt] then
        originalPromptSettings[prompt] = {
            HoldDuration = prompt.HoldDuration
        }
    end
end

local function enableInstantInteract()
    for _, descendant in pairs(workspace:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            setupProximityPrompt(descendant)
            descendant.HoldDuration = 0
        end
    end
end

local function disableInstantInteract()
    for prompt, settings in pairs(originalPromptSettings) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = settings.HoldDuration
        end
    end
end

workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") and instantInteractEnabled then
        setupProximityPrompt(descendant)
        descendant.HoldDuration = 0
    end
end)

local dragging
local dragInput
local dragStart
local startPos

local function updateInput(input)
    if isClosing then return end
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

TitleBar.InputBegan:Connect(function(input)
    if isClosing then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateInput(input)
    end
end)

local function buttonHoverEffect(button, hoverColor, normalColor)
    button.MouseEnter:Connect(function()
        createTween(button, {BackgroundColor3 = hoverColor}, 0.2):Play()
    end)
    
    button.MouseLeave:Connect(function()
        createTween(button, {BackgroundColor3 = normalColor}, 0.2):Play()
    end)
end

